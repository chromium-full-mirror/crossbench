query {
  id: "tab_timing_query"
  table {
    table_name: "tab_timing_by_tab_index"
    module_name: "sql_packages.multiwindow_memory_stress.tab_timing"
    column_names: "it_id"
    column_names: "tab_index"
    column_names: "page_load_duration_ms"
    column_names: "allocation_duration_ms"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.page_load_duration_ms"
  dimensions: "it_id"
  value: "page_load_duration_ms"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "tab_timing_query"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.allocation_duration_ms"
  dimensions: "it_id"
  value: "allocation_duration_ms"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "tab_timing_query"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.page_load_duration_ms_by_tab_index"
  dimensions: "it_id"
  dimensions: "tab_index"
  value: "page_load_duration_ms"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "tab_timing_query"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.allocation_duration_ms_by_tab_index"
  dimensions: "it_id"
  dimensions: "tab_index"
  value: "allocation_duration_ms"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "tab_timing_query"
  }
}

query {
  id: "tab_revisit_query"
  table {
    table_name: "tab_revisit_by_tab_index"
    module_name: "sql_packages.multiwindow_memory_stress.tab_revisit"
    column_names: "it_id"
    column_names: "tab_index"
    column_names: "tab_revisit_duration_ms"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.tab_revisit_duration_ms"
  dimensions: "it_id"
  value: "tab_revisit_duration_ms"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "tab_revisit_query"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.tab_revisit_duration_ms_by_tab_index"
  dimensions: "it_id"
  dimensions: "tab_index"
  value: "tab_revisit_duration_ms"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "tab_revisit_query"
  }
}

query {
  id: "uma_histogram_summaries_query"
  table {
    table_name: "uma_histogram_summaries"
    module_name: "sql_packages.multiwindow_memory_stress.uma"
    column_names: "hist_name"
    column_names: "agg_type"
    column_names: "value"
    column_names: "polarity"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.uma.lower_is_better"
  dimensions: "hist_name"
  dimensions: "agg_type"
  value: "value"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "uma_histogram_summaries_query"
    filters {
      column_name: "polarity"
      op: EQUAL
      string_rhs: "LOWER_IS_BETTER"
    }
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.uma.higher_is_better"
  dimensions: "hist_name"
  dimensions: "agg_type"
  value: "value"
  polarity: HIGHER_IS_BETTER
  query: {
    inner_query_id: "uma_histogram_summaries_query"
    filters {
      column_name: "polarity"
      op: EQUAL
      string_rhs: "HIGHER_IS_BETTER"
    }
  }
}

query {
  id: "meminfo_total_query"
  table {
    table_name: "meminfo_total_output"
    module_name: "sql_packages.multiwindow_memory_stress.meminfo"
    column_names: "it_id"
    column_names: "title"
    column_names: "pss_total_mb"
    column_names: "rss_total_mb"
    column_names: "swap_total_mb"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.meminfo.browser_pss_total_mb"
  dimensions: "it_id"
  dimensions: "title"
  value: "pss_total_mb"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "meminfo_total_query"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.meminfo.browser_rss_total_mb"
  dimensions: "it_id"
  dimensions: "title"
  value: "rss_total_mb"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "meminfo_total_query"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.meminfo.browser_swap_total_mb"
  dimensions: "it_id"
  dimensions: "title"
  value: "swap_total_mb"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "meminfo_total_query"
  }
}

query {
  id: "cpu_usage_stat_query"
  table {
    table_name: "cpu_usage_stat_output"
    module_name: "sql_packages.multiwindow_memory_stress.cpu"
    column_names: "name"
    column_names: "total_cputime"
  }
}

metric_spec: {
  id: "multiwindow-memory-stress.cpu_usage_stat.total_cputime"
  dimensions: "name"
  value: "total_cputime"
  polarity: LOWER_IS_BETTER
  query {
    inner_query_id: "cpu_usage_stat_query"
  }
}
