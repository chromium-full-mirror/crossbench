{
  "name": "loadline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:git": "node scripts/check_git_status.mjs",
    "prepare:bin": "node scripts/fetch_binaries.mjs",
    "predev": "npm run prepare:bin",
    "prebuild": "npm run check:git && npm run prepare:bin",
    "pretest": "npm run prepare:bin",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "pyodide": "0.29.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "happy-dom": "14.12.3",
    "typescript": "5.9.3",
    "undici": "6.21.1",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
