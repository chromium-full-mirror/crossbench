[submodule "buildtools"]
	path = buildtools
	url = https://chromium.googlesource.com/chromium/src/buildtools
	gclient-condition = not build_with_chromium
[submodule "third_party/clang-format/script"]
	path = third_party/clang-format/script
	url = https://chromium.googlesource.com/external/github.com/llvm/llvm-project/clang/tools/clang-format
	gclient-condition = not build_with_chromium
[submodule "third_party/hjson_js"]
	path = third_party/hjson_js
	url = https://chromium.googlesource.com/external/github.com/hjson/hjson-js
[submodule "third_party/tsproxy"]
	path = third_party/tsproxy
	url = https://chromium.googlesource.com/external/github.com/catchpoint/WebPageTest.tsproxy
[submodule "third_party/webpagereplay"]
	path = third_party/webpagereplay
	url = https://chromium.googlesource.com/webpagereplay
	gclient-condition = not build_with_chromium
[submodule "internal"]
	path = internal
	url = https://chrome-internal.googlesource.com/crossbench/crossbench-internal
	gclient-condition = checkout_crossbench_internal
