buffers {
  size_kb: 262144
  fill_policy: DISCARD
}
data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 5000
    }
  }
}
data_sources {
  config {
    name: "android.heapprofd"
    heapprofd_config {
      sampling_interval_bytes: 4096
      process_cmdline: "org.chromium.webview_shell"
      process_cmdline: "com.google.android.webview.debug:sandboxed_process0:org.chromium.content.app.SandboxedProcessServi"
      continuous_dump_config {
        dump_phase_ms: 0
        dump_interval_ms: 5000
      }
      shmem_size_bytes: 8388608
      block_client: true
      all_heaps: false
    }
  }
}
data_sources {
  config {
    name: "android.java_hprof"
    java_hprof_config {
      process_cmdline: "org.chromium.webview_shell"
      process_cmdline: "com.google.android.webview.debug:sandboxed_process0:org.chromium.content.app.SandboxedProcessServi"
      continuous_dump_config {
        dump_phase_ms: 0
        dump_interval_ms: 5000
      }
    }
  }
}
data_source_stop_timeout_ms: 100000
duration_ms: 1800000