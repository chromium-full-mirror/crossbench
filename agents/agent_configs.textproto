# proto-file: google3/google/corp/android/engprod/codereviewagentconfiguration/v1/agent.proto

configs {
  id: "cb-style"
  display_name: "Python Style"
  description: "Generic crossbench python coding style guide"
  skills: "agents/skills/style/SKILL.md"
  include_filters {
    project: "crossbench"
    path_regex: ".*\\.py$"
  }
  exclude_filters {
    path_regex: "third_party/.*"
  }
  automatic: true
}

configs {
  id: "cb-plt-code"
  display_name: "Platform Abstractions"
  description: "Guidelines for crossbench plt / Platform code"
  skills: "agents/skills/plt-code/SKILL.md"
  include_filters {
    project: "crossbench"
    path_regex: "crossbench/.*\\.py$"
  }
  automatic: true
}

configs {
  id: "cb-configs"
  display_name: "Config & Input Parsing"
  description: "Guidelines for crossbench ConfigObjects"
  skills: "agents/skills/configs/SKILL.md"
  include_filters {
    project: "crossbench"
    path_regex: ".*\\.py$"
  }
  exclude_filters {
    path_regex: "third_party/.*"
    path_regex: "tests/.*"
  }
  automatic: true
}
