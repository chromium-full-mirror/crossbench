# proto-file: google3/google/corp/android/engprod/codereviewagentconfiguration/v1/agent.proto

configs {
  id: "crossbench-python-style"
  display_name: "Crossbench Python Style"
  description: "Enforces Google Python style, 80-character line limit, typing, and bans on getattr/hasattr."
  skills: "agents/skills/python-style/SKILL.md"
  include_filters {
    project: "crossbench"
    path_regex: ".*\\.py$"
  }
  exclude_filters {
    path_regex: "third_party/.*"
  }
  automatic: true
}

configs {
  id: "crossbench-platform-code"
  display_name: "Crossbench Platform Abstractions"
  description: "Enforces usage of Platform helpers, path abstractions (LocalPath vs AnyPath), and bans raw shell commands or shell=True."
  skills: "agents/skills/platform-code/SKILL.md"
  include_filters {
    project: "crossbench"
    path_regex: "crossbench/.*\\.py$"
  }
  automatic: true
}

configs {
  id: "crossbench-config-objects"
  display_name: "Crossbench Config & Input Parsing"
  description: "Ensures inputs use crossbench.parse and complex options use immutable ConfigObjects with unit tests."
  skills: "agents/skills/config-objects/SKILL.md"
  include_filters {
    project: "crossbench"
    path_regex: ".*\\.py$"
  }
  exclude_filters {
    path_regex: "third_party/.*"
    path_regex: "tests/.*"
  }
  automatic: true
}
